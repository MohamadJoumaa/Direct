{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./src/*"],
      "@direct/shared": ["../../packages/shared/src/index.ts"],
      "@direct/core": ["../../packages/core/src/index.ts"],
      "@direct/i18n": ["../../packages/i18n/src/index.ts"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "../../packages/shared/src/**/*.ts",
    "../../packages/core/src/**/*.ts",
    "../../packages/i18n/src/**/*.ts"
  ],
  "exclude": ["node_modules", "../../packages/shared/src/**/*.test.ts"]
}
