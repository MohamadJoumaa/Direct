# Copy to .env.local. Every EXPO_PUBLIC_* value is inlined into the JS bundle,
# so none of these may ever be a secret.

# Origin of the deployed Next.js app. Only the parked merchant-collect client
# (src/lib/whish.ts) uses it. The live driver payment flow opens the Whish app
# directly, so leaving this empty does not break paying.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Optional, and deliberately NOT required for `expo start`: Expo Go carries
# Google's own Maps key, so the map renders in Expo Go without this. A
# dev-client or store build on Android does need it — without it `mapsAvailable()`
# is false there and the panels fall back to a labelled list, exactly like the
# website. The key must have "Maps SDK for Android" enabled; a browser key
# restricted to HTTP referrers renders a blank grey tile.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Phase 2 Workstream A. Unused until the Supabase cutover lands.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
