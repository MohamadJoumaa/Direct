# Copy to .env.local. Every EXPO_PUBLIC_* value is inlined into the JS bundle,
# so none of these may ever be a secret — the Whish channel/secret stay on the
# web deployment and are reached through EXPO_PUBLIC_WEB_URL.

# Origin of the deployed Next.js app. Mobile calls its /api/whish/* routes for
# every collect create / status check, so unlock stays server-verified.
EXPO_PUBLIC_WEB_URL=http://localhost:3000

# Optional. Without it the map panels fall back to markers over a plain canvas
# and distances fall back to haversine, exactly like the website.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=

# Phase 2 Workstream A. Unused until the Supabase cutover lands.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
