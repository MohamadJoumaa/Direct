NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_DEMO_MODE=true

# Whish Pay (merchant collect). Without these, drivers use “I already paid”
# and an admin confirms in Budget → Whish. Do not use these for P2P phone inquiry —
# Whish has no documented API to verify freeform Whish→Whish transfers.
WHISH_CHANNEL=
WHISH_SECRET=
# Merchant websiteurl header (must match the URL registered with Whish).
WHISH_WEBSITE_URL=https://direct.delivery
# Sandbox: https://lb.sandbox.whish.money/itel-service/api
# Production: set to the live Whish API base your merchant account uses.
WHISH_BASE_URL=https://lb.sandbox.whish.money/itel-service/api
